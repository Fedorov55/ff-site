{
  "name": "ff-site",
  "version": "1.0.0",
  "description": "F&F IT-outsourcing site",
  "scripts": {
    "build": "node build.js",
    "build:css": "npx esbuild css/style.css --minify --outfile=dist/style.min.css",
    "build:js": "npx esbuild js/script.js --minify --outfile=dist/script.min.js",
    "lint:js": "npx eslint js/script.js js/calculator.js js/search.js",
    "lint:html": "npx htmlhint \"**/*.html\"",
    "audit": "node --check js/script.js && node --check js/calculator.js && node --check js/search.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "htmlhint": "^1.9.2",
    "esbuild": "^0.25.0",
    "purgecss": "^9.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}